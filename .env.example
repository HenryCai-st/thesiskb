# Copy to .env and adjust. Never commit .env.

# Postgres (matches docker-compose.yml defaults)
TKB_DATABASE_URL=postgresql+psycopg://thesiskb:thesiskb@localhost:5432/thesiskb

# Ollama (local) — LiteLLM talks to it over HTTP
TKB_OLLAMA_BASE_URL=http://localhost:11434

# Tesseract OCR (Milestone 3). On Windows the installer does not add it to PATH, and
# Program Files is read-only, so language packs (deu/eng/osd) may live in a user folder.
# TKB_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TKB_TESSDATA_DIR=C:\Users\<you>\AppData\Local\thesiskb\tessdata

# Hugging Face READ token for gated models (pyannote speaker separation). Accept the terms on
# huggingface.co/pyannote/speaker-diarization-community-1 first.
TKB_HF_TOKEN=

# API / web UI (tkb serve). Set a token before binding to anything but 127.0.0.1.
# TKB_API_TOKEN=
# Base URL for source links in chat replies (Open WebUI); default: the address of the request
# TKB_PUBLIC_URL=http://127.0.0.1:8000

# Optional cloud API keys for "API mode" (read by LiteLLM directly)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
